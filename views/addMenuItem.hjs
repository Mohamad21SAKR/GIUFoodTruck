<%- include('partials/ownerNav'); %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Menu Item</title>

  <link rel="stylesheet" href="/styles/bootstrap.min.css">
  <link rel="stylesheet" href="/styles/style.css">

  <script src="/js/jquery-2.2.0.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
</head>

<body>

<div id="msg" style="display:none; padding:10px; margin:10px 0; border-radius:6px;"></div>

<nav class="navbar navbar-inverse">
  <div class="container-fluid">
    <div class="navbar-header">
      <a class="navbar-brand" href="/ownerDashboard">GIU FoodTruck</a>
    </div>

    <ul class="nav navbar-nav">
      <li><a href="/ownerDashboard">Home</a></li>
      <li><a href="/menuItems">Menu Items</a></li>
      <li class="active"><a href="/addMenuItem">Add Item</a></li>
      <li><a href="/truckOrders">Orders</a></li>
    </ul>

    <ul class="nav navbar-nav navbar-right">
      <li><a href="/dashboard">Switch View</a></li>
      <li><a href="/logout">Logout</a></li>
    </ul>
  </div>
</nav>

<div class="container" style="max-width:600px; margin-top:25px;">
  <h2 class="text-center">Add Menu Item</h2>

  <div class="panel panel-default">
    <div class="panel-body">

      <div class="form-group">
        <label>Name *</label>
        <input id="name" class="form-control" type="text" placeholder="Item name">
      </div>

      <div class="form-group">
        <label>Category *</label>
        <input id="category" class="form-control" type="text" placeholder="e.g. Burger, Drinks">
      </div>

      <div class="form-group">
        <label>Description</label>
        <textarea id="description" class="form-control" rows="3" placeholder="Optional description"></textarea>
      </div>

      <div class="form-group">
        <label>Price *</label>
        <input id="price" class="form-control" type="number" step="0.01" placeholder="e.g. 50">
      </div>

      <div class="text-center">
        <button id="addBtn" class="btn btn-success">Add Menu Item</button>
        <a href="/menuItems" class="btn btn-default">Cancel</a>
      </div>

      <!-- ✅ KEEP but FIX: avoid duplicate id="msg" -->
      <p id="msgInline" class="text-center" style="margin-top:15px;"></p>

    </div>
  </div>
</div>

<script src="/src/addMenuItem.js"></script>
</body>
</html>
