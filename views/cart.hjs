<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>GIU FoodTruck - Cart</title>

  <link rel="stylesheet" href="/styles/bootstrap.min.css">
  <link rel="stylesheet" href="/styles/style.css">
</head>
<body>

  <div id="popupMsg" style="display:none; position:fixed; top:20px; right:20px; z-index:99999; min-width:280px;"></div>

  <div id="msg" style="display:none; padding:10px; margin:10px 0; border-radius:6px;"></div>

  <!-- Navbar (simple) -->
  <nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="/">GIU FoodTruck</a>
    <a class="btn btn-warning btn-sm" href="/register">Register</a>
  </nav>

  <!-- ✅ KEEP: your existing content (not deleted) -->
  <div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="card p-4 shadow" style="max-width: 420px; width: 100%;">
      <div class="text-center mb-3">
        <h4 class="mb-1">Welcome Back!</h4>
        <small class="text-muted">Sign in to continue</small>
      </div>

      <!-- messages -->
      <div id="msgInner"></div>

      <div class="mb-3">
        <label class="form-label">Email Address</label>
        <input id="email" type="email" class="form-control" placeholder="Enter email">
      </div>

      <div class="mb-3">
        <label class="form-label">Password</label>
        <input id="password" type="password" class="form-control" placeholder="Enter password">
      </div>

      <button id="btnLogin" class="btn btn-warning w-100">Sign In</button>

      <div class="text-center mt-3">
        <small>Don't have an account? <a href="/register">Register</a></small>
      </div>
    </div>
  </div>

  <!-- ✅ ADDED: real cart UI (so /src/cart.js works) -->
  <div class="container my-4">
    <h3 class="mb-3">My Cart</h3>

    <!-- optional inputs used by cart.js if you added them -->
    <div class="row g-2 mb-3">
      <div class="col-md-4">
        <label class="form-label">Payment Method</label>
        <select id="paymentMethod" class="form-control">
          <option value="cash">Cash</option>
          <option value="card">Card</option>
        </select>
      </div>
      <div class="col-md-8">
        <label class="form-label">Customer Notes</label>
        <input id="customerNotes" class="form-control" placeholder="Any notes for the truck?">
      </div>
    </div>

    <!-- optional scheduled time -->
    <div class="mb-3">
      <label class="form-label">Scheduled Pickup Time (optional)</label>
      <input id="scheduledPickupTime" type="datetime-local" class="form-control">
    </div>

    <div class="alert alert-info" id="loadingCart" style="display:none;">Loading cart...</div>

    <div id="cartContainer"></div>

    <div class="d-flex justify-content-between align-items-center mt-3">
      <h5>Total: <span id="cartTotal">0</span> EGP</h5>
      <button id="btnPlaceOrder" class="btn btn-success">Place Order</button>
    </div>
  </div>

  <script src="/js/jquery-2.2.0.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>

  <!-- ✅ KEEP: your old login.js include (not deleted) -->
  <script src="/src/login.js"></script>

  <!-- ✅ ADDED: real cart logic -->
  <script src="/src/cart.js"></script>
</body>
</html>
