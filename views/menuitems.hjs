<%- include('partials/ownerNav'); %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Menu Items</title>

  <link rel="stylesheet" href="/styles/bootstrap.min.css">
  <link rel="stylesheet" href="/styles/style.css">

  <script src="/js/jquery-2.2.0.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
</head>

<body>

<div id="msg" style="display:none; padding:10px; margin:10px 0; border-radius:6px;"></div>

<nav class="navbar navbar-inverse">
  <div class="container-fluid">
    <div class="navbar-header">
      <a class="navbar-brand" href="/ownerDashboard">GIU FoodTruck</a>
    </div>

    <ul class="nav navbar-nav">
      <li><a href="/ownerDashboard">Home</a></li>
      <!-- ✅ changed /menuItems to /menuitems -->
      <li class="active"><a href="/menuitems">Menu Items</a></li>
      <li><a href="/addMenuItem">Add Item</a></li>
      <li><a href="/truckOrders">Orders</a></li>
    </ul>

    <ul class="nav navbar-nav navbar-right">
      <li><a href="/dashboard">Switch View</a></li>
      <li><a href="/logout">Logout</a></li>
    </ul>
  </div>
</nav>

<div class="container">
  <h2 class="text-center">Menu Items Management</h2>

  <div class="text-right" style="margin-bottom: 15px;">
    <a href="/addMenuItem" class="btn btn-success">+ Add New Item</a>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Category</th>
          <th>Description</th>
          <th>Price</th>
          <th>Status</th>
          <th style="width:170px;">Actions</th>
        </tr>
      </thead>
      <tbody id="itemsBody">
        <!-- filled by JS -->
      </tbody>
    </table>
  </div>

  <p id="emptyMsg" class="text-center" style="display:none;">No menu items found.</p>
</div>

<!-- ✅ changed menuItems.js to menuitems.js -->
<script src="/src/menuitems.js"></script>
</body>
</html>
